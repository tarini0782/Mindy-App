# ---------------------------------------------------------------- secrets
# Never commit a real key. backend/.env.example holds placeholders only.
backend/.env
.env
*.pem
*.key

# ------------------------------------------------------------ participant data
# Nothing here should ever contain real children's data, but these patterns
# exist so an accidental export cannot be committed without noticing.
backend/*.sqlite3
backend/*.db
exports/
*_participant_data.*

# ----------------------------------------------------------- evaluation output
# Regenerated by `flutter test test/evaluation_harness_test.dart`.
# Synthetic, but large and not worth versioning. The condition key in here
# must NOT be shared with raters.
build/eval/

# ------------------------------------------------------------------ Flutter
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
coverage/
*.iml

# pubspec.lock IS committed for an application: it pins the exact versions
# the submitted build used, which matters for reproducibility.

# ------------------------------------------------------------------- Android
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore

# ----------------------------------------------------------------------- iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# -------------------------------------------------------------------- Python
__pycache__/
*.pyc
.venv/
venv/

# --------------------------------------------------------------------- tools
.idea/
.vscode/
.DS_Store
Thumbs.db

# Exclude machine-learning component from GitHub
mindy_ml/

# Exclude accidental temporary files
&1
copy
