# Copy this file to .env (same folder as server.py) and fill in ONE provider.
# .env is read by insight_summary.load_dotenv() when the backend starts.
# Never commit your real .env -- keep it out of git/zips you hand in.

# "anthropic" or "openai"
MINDY_LLM_PROVIDER=anthropic

# Your own API key from console.anthropic.com or platform.openai.com.
MINDY_LLM_API_KEY=

# Optional. Defaults: claude-3-5-haiku-20241022 (anthropic), gpt-4o-mini (openai).
MINDY_LLM_MODEL=

# Optional. Seconds before the backend gives up and falls back. Default 8.
MINDY_LLM_TIMEOUT_S=8
